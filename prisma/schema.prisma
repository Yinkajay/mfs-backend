generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

// This discriminator keeps customer login separate from future staff login.
// Staff provisioning, roles, permissions, and MFA are not implemented here.
enum AccountKind {
  CUSTOMER
  STAFF
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  firstName         String             @map("first_name") @db.VarChar(80)
  lastName          String             @map("last_name") @db.VarChar(80)
  email             String             @unique @db.VarChar(254)
  phone             String             @db.VarChar(16)
  passwordHash      String             @map("password_hash") @db.VarChar(255)
  emailVerifiedAt   DateTime?          @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt   DateTime?          @map("phone_verified_at") @db.Timestamptz(3)
  kind              AccountKind        @default(CUSTOMER)
  status            UserStatus         @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions          Session[]
  vehicleOwnerships VehicleOwnership[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

// Atomic, expiring counters shared by API instances; no Redis is needed yet.
// Keys contain hashes, never plaintext emails or IP addresses.
model AuthRateLimit {
  keyHash   String   @id @map("key_hash") @db.Char(64)
  attempts  Int      @default(1)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_rate_limits")
}

enum VehicleCategoryCode {
  BIKE
  SALOON
  SUV_PICKUP
  TRUCK
  BUS_MINI_TRUCK
}

enum PricingStrategy {
  FIXED_BY_VEHICLE_CATEGORY
  FIXED_BY_VARIANT
  FIXED_UNIVERSAL
  PERCENTAGE_OF_DECLARED_VALUE
  MANUAL_QUOTE
  MANUAL_REVIEW
}

enum PricingRuleStatus {
  ACTIVE
  PENDING_CONFIRMATION
  RETIRED
}

model VehicleCategory {
  code         VehicleCategoryCode      @id
  name         String                   @db.VarChar(60)
  vehicles     Vehicle[]
  services     ServiceVehicleCategory[]
  pricingRules PricingRule[]

  @@map("vehicle_categories")
}

model Vehicle {
  id                           String              @id @default(uuid()) @db.Uuid
  name                         String?             @db.VarChar(80)
  category                     VehicleCategoryCode @map("category_code")
  registrationNumber           String?             @map("registration_number") @db.VarChar(80)
  registrationNumberNormalized String?             @map("registration_number_normalized") @db.VarChar(240)
  make                         String?             @db.VarChar(80)
  model                        String?             @db.VarChar(80)
  year                         Int?
  colour                       String?             @db.VarChar(80)
  chassisNumber                String?             @map("chassis_number") @db.VarChar(80)
  engineNumber                 String?             @map("engine_number") @db.VarChar(80)
  engineCapacity               String?             @map("engine_capacity") @db.VarChar(40)
  usageType                    String?             @map("usage_type") @db.VarChar(40)
  stateOfRegistration          String?             @map("state_of_registration") @db.VarChar(80)
  createdAt                    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  categoryRecord               VehicleCategory     @relation(fields: [category], references: [code], onDelete: Restrict)
  ownership                    VehicleOwnership?

  @@index([registrationNumberNormalized])
  @@index([createdAt, id])
  @@map("vehicles")
}

// Keep ownership separate from vehicle details. Organization ownership can
// extend this association later; this API only creates individual ownerships.
model VehicleOwnership {
  vehicleId String  @id @map("vehicle_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, vehicleId])
  @@map("vehicle_ownerships")
}

model Service {
  id                   String                   @id @default(uuid()) @db.Uuid
  code                 String                   @unique @db.VarChar(80)
  name                 String                   @db.VarChar(120)
  slug                 String                   @unique @db.VarChar(120)
  description          String?                  @db.Text
  active               Boolean                  @default(true)
  sortOrder            Int                      @map("sort_order")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  variants             ServiceVariant[]
  applicableCategories ServiceVehicleCategory[]
  pricingRules         PricingRule[]

  @@index([active, sortOrder, id])
  @@map("services")
}

model ServiceVariant {
  id           String        @id @default(uuid()) @db.Uuid
  serviceId    String        @map("service_id") @db.Uuid
  code         String        @db.VarChar(60)
  name         String        @db.VarChar(80)
  description  String?       @db.Text
  active       Boolean       @default(true)
  sortOrder    Int           @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  pricingRules PricingRule[]

  @@unique([serviceId, code])
  @@index([serviceId, active, sortOrder, id])
  @@map("service_variants")
}

model ServiceVehicleCategory {
  serviceId    String              @map("service_id") @db.Uuid
  categoryCode VehicleCategoryCode @map("category_code")
  service      Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  category     VehicleCategory     @relation(fields: [categoryCode], references: [code], onDelete: Restrict)

  @@id([serviceId, categoryCode])
  @@index([categoryCode, serviceId])
  @@map("service_vehicle_categories")
}

model PricingRule {
  id                  String               @id @default(uuid()) @db.Uuid
  serviceId           String               @map("service_id") @db.Uuid
  vehicleCategoryCode VehicleCategoryCode? @map("vehicle_category_code")
  serviceVariantId    String?              @map("service_variant_id") @db.Uuid
  strategy            PricingStrategy
  amount              Decimal?             @db.Decimal(18, 2)
  percentage          Decimal?             @db.Decimal(7, 4)
  currency            String               @default("NGN") @db.Char(3)
  effectiveFrom       DateTime             @map("effective_from") @db.Timestamptz(3)
  effectiveTo         DateTime?            @map("effective_to") @db.Timestamptz(3)
  status              PricingRuleStatus    @default(PENDING_CONFIRMATION)
  version             Int
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  service             Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  vehicleCategory     VehicleCategory?     @relation(fields: [vehicleCategoryCode], references: [code], onDelete: Restrict)
  serviceVariant      ServiceVariant?      @relation(fields: [serviceVariantId], references: [id], onDelete: Restrict)

  @@index([serviceId, status, effectiveFrom, effectiveTo])
  @@index([vehicleCategoryCode, serviceId])
  @@index([serviceVariantId, serviceId])
  @@map("pricing_rules")
}
