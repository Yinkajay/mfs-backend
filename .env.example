# Backend only. Keep frontend environment files separate.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
SWAGGER_ENABLED=true

# Exact browser origins only (no paths, trailing slash, or wildcard).
# Production requires HTTPS; configure the real frontend origin before launch.
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Local HTTP only. Set true for any public HTTPS environment; mandatory in production.
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
SESSION_IDLE_TTL_SECONDS=86400
AUTH_RATE_LIMIT_NAMESPACE=customer-auth
AUTH_RATE_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_REGISTER_IP_LIMIT=10
AUTH_REGISTER_ACCOUNT_LIMIT=3
# Keep 0 unless a known, restricted reverse-proxy topology is configured.
TRUST_PROXY_HOPS=0

# Local PostgreSQL defaults. These credentials are for local development only.
POSTGRES_USER=mfs
POSTGRES_PASSWORD=mfs_local
POSTGRES_DB=mfs
POSTGRES_PORT=5433
DATABASE_URL="postgresql://mfs:mfs_local@127.0.0.1:5433/mfs?schema=public"
# Neon env pull supplies DATABASE_URL_UNPOOLED for migration commands.
# Leave empty for the local Compose database; do not paste real URLs here.
DATABASE_URL_UNPOOLED=""
