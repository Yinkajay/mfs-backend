{
  "name": "mfs-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MFS Services backend foundation",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "npm run prisma:generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src prisma.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:integration": "npm run build && node test/auth.integration.cjs",
    "check": "npm run prisma:validate && npm run lint && npm run format:check && npm test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "db:up": "docker compose --env-file .env up -d --wait",
    "db:down": "docker compose --env-file .env down",
    "db:status": "docker compose --env-file .env ps",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:development": "node scripts/migrate-development.cjs",
    "db:migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "libphonenumber-js": "^1.12.31",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.6.0",
    "prisma": "7.10.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.2"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  }
}
